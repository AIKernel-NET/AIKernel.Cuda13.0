<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <StablePackageVersion>0.1.3</StablePackageVersion>
    <LocalPackageVersionPrefix>0.1.3</LocalPackageVersionPrefix>
    <LocalPackageBuildNumber Condition="'$(LocalPackageBuildNumber)' == ''">0</LocalPackageBuildNumber>
    <UseLocalPackageVersion Condition="'$(UseLocalPackageVersion)' == ''">false</UseLocalPackageVersion>
    <Version Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</Version>
    <Version Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</Version>
    <AssemblyVersion>$(StablePackageVersion).0</AssemblyVersion>
    <FileVersion>$(StablePackageVersion).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AIKernelContractPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelContractPackageVersion>
    <AIKernelContractPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelContractPackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelCorePackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelCorePackageVersion>

    <AssemblyName>AIKernel.Cuda13.0.Libtorch2.12.win-x64</AssemblyName>
    <RootNamespace>AIKernel.Cuda13.Libtorch2_12.WinX64</RootNamespace>
    <PackageId>AIKernel.Cuda13.0.Libtorch2.12.win-x64</PackageId>
    <Title>AIKernel.Cuda13.0.Libtorch2.12.win-x64</Title>
    <Description>Legacy LibTorch reference implementation for Windows x64 through 0.1.3. Maintenance has ended. Use the CUDA Driver bundled with AIKernel.Kernel 0.1.4.</Description>
    <Authors>Takuya Sogawa</Authors>
    <Company>AIKernel-NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AIKernel-NET/AIKernel.Cuda13.0</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AIKernel-NET/AIKernel.Cuda13.0</RepositoryUrl>
    <Copyright>Copyright © 2026 Takuya Sogawa of AIKernel-NET</Copyright>
    <PackageTags>aikernel;capability;cuda;cuda13;libtorch;native-abi;gpu;llm;slm</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>aikernel-logo128x128.png</PackageIcon>
    <AIKernelNativeBridgePath Condition="'$(AIKernelNativeBridgePath)' == ''">$(MSBuildThisFileDirectory)..\..\native\build\win-x64\Release\libtorch_bridge.dll</AIKernelNativeBridgePath>
    <PackageReleaseNotes>Maintenance has ended. The successor is the CUDA Driver bundled with AIKernel.Kernel 0.1.4.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AIKernel.Abstractions" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="AIKernel.Core" Version="$(AIKernelCorePackageVersion)" />
    <PackageReference Include="AIKernel.Kernel" Version="$(AIKernelCorePackageVersion)" />
    <PackageReference Include="AIKernel.Dtos" Version="$(AIKernelContractPackageVersion)" />
    <PackageReference Include="AIKernel.Enums" Version="$(AIKernelContractPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\RELEASE_NOTES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\aikernel-logo128x128.png" Pack="true" PackagePath="\" />
    <Content Include="loader.json" Pack="true" PackagePath="contentFiles\any\any\loader.json" PackageCopyToOutput="true" CopyToOutputDirectory="PreserveNewest" />
    <None Include="loader.json" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(AIKernelNativeBridgePath)')">
    <None Include="$(AIKernelNativeBridgePath)" Pack="true" PackagePath="runtimes\win-x64\native\" />
  </ItemGroup>

</Project>
